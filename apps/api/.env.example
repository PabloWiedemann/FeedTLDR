# Copy to .env and fill in. Never commit .env.
# Firebase Admin SDK reads the service-account JSON from
# ${PROJECT_DIR}/${CREDENTIALS_DIR}/firebase_credentials_secret_prod.json
PROJECT_DIR=/absolute/path/to/FeedTLDR/apps/api
CREDENTIALS_DIR=credentials

FIREBASE_WEB_API_KEY=
# Signup protection. Leave blank locally; see docs/ABUSE_PROTECTION_SETUP.md.
TURNSTILE_SECRET_KEY=
SIGNUP_CHALLENGE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=feedtldr.com,www.feedtldr.com

# Enable only after traffic reaches the API through a trusted proxy such as
# Cloudflare. A value of 0 disables the corresponding in-process limit.
TRUST_PROXY_HEADERS=0
SIGNUP_CHALLENGE_RATE_LIMIT_PER_HOUR=0
SIGNUP_RATE_LIMIT_PER_DAY=0

# Enable only after the web App Check key is deployed and verified.
FIREBASE_APP_CHECK_ENFORCED=0
APIFY_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Resend (newsletter emails, sender domain mail.feedtldr.com)
RESEND_API_KEY=

# Where operator notifications (new-signup emails) go; empty disables them
SIGNUP_NOTIFY_EMAIL=

STRIPE_ENV=test
STRIPE_API_KEY_TEST=
STRIPE_API_KEY_LIVE=

# Public origin of the web app (used for Stripe success/cancel redirect URLs)
DOMAIN_URL=http://localhost:3000

# Origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Set to 1 to also run the newsletter daemon inside the API process
# (single-service deployment). Leave unset to run `python -m worker` separately.
RUN_WORKER=
