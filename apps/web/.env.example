# Copy to .env.local and fill in. All values here are exposed to the browser.

# FastAPI backend (apps/api dev server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase web app (Firebase console → project settings → your web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Optional: proxy Firebase auth through the app's own domain
NEXT_PUBLIC_AUTH_PROXY=

# Cloudflare Turnstile (signup bot check); leave empty to disable locally
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog analytics (project settings → Project API key); empty disables tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set to 1 to preview /onboarding with an already-onboarded account (dev server only,
# nothing is saved); ignored in production builds
NEXT_PUBLIC_ONBOARDING_PREVIEW=
